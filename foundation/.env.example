# 默认 GPT-6.1 Sol；切换 DeepSeek 时用 DSH 中同款 V4.1-Flash（当前1017）。
# 不要把 API Key 填进聊天或用户资料；DeepSeek和Gemini仍可手动切换。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUTH_MODE=api-key
# 账号模式设置为codex-account；需本机官方Codex客户端已登录ChatGPT。
# CODEX_EXECUTABLE=C:/本机Codex安装目录/codex.exe

# 可选 DeepSeek 通道，需使用自己的独立 API 凭据；不是 DSH 登录令牌。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选 Gemini 独立通道；密钥来自 Google AI Studio，只在本机填写。
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
# 更换模型时按该模型官方规格更新输入上限，仅用于上下文长度保护。
GEMINI_CONTEXT_LIMIT=1048576

# 电脑操作使用 UI-TARS 适配的视觉模型；不自动沿用聊天模型。
GUI_BASE_URL=
GUI_API_KEY=
GUI_MODEL=
GUI_MODEL_VERSION=1.5
GUI_MAX_STEPS=25

PORT=4317
MODEL_TIMEOUT_MS=120000
# 如需使用本机已配置的HTTP代理：填HTTPS_PROXY，并启用NODE_USE_ENV_PROXY=1。
# 留空不启用；不修改Windows系统代理，绝不关闭TLS证书校验。
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:你的代理端口
# NO_PROXY=127.0.0.1,localhost,::1,api.deepseek.com
# 相对于本项目目录，也可以填本机绝对路径。
FOUNDATION_DATA_DIR=data

# 本地长离语音包根目录。首次语音会加载已通过的专属权重；不使用收费 TTS。
CHANGLI_VOICE_ROOT=D:/GPT/背景项目/长离语音包
